# Copie este arquivo para .env e preencha somente a chave do provedor escolhido.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Necessário quando a chave da organização não está vinculada a um workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternativa opcional:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Use "demo" somente para navegar pela interface sem consumir uma API.
# LLM_PROVIDER=demo

DATABASE_PATH=data/insurminds.db
MAX_DOCUMENT_PAGES=150
LLM_CHUNK_CHARS=28000
LLM_TEMPERATURE=0
OCR_LANGUAGE=por+eng
TESSERACT_CMD=
